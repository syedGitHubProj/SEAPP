# Owner's local files (may hold real customer data) — never commit
*.xlsm
*.xlsx
!docs/**/*.xlsx

# Secrets / local settings
.env
.env.*
!.env.example
.claude/settings.local.json

# OS / editors
.DS_Store
.vscode/
.idea/

# .NET
bin/
obj/
TestResults/
*.user

# Node / Next.js
node_modules/
.next/
.next-e2e/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
next-env.d.ts

# Office temporary lock files (created while a document is open)
~$*

# Design photos stored on a developer computer (API "Local" photo store)
api/src/SellEase.Api/local-photos/
api/src/SellEase.Api/local-photos-e2e/

# Playwright sign-in state (made by e2e/auth.setup.ts)
web/e2e/.auth/
