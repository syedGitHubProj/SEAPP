# Copy to .env on the server (same folder as docker-compose.yml) and fill in.
# The owner types the real values on the server. Never commit .env.

# Short name for this client + environment. Must match the Caddy site file and the GitHub environment.
STACK=abc-staging
# Staging allows the demo-data and wipe buttons. The live server uses Production.
APP_ENVIRONMENT=Staging
# GitHub account that owns the images, in lowercase.
IMAGE_OWNER=syedgithubproj

# Database password: letters and numbers only (make one with:  openssl rand -hex 24).
POSTGRES_PASSWORD=

# Design photos: S3 = DigitalOcean Spaces (recommended), Local = a folder on this server.
PHOTOS_STORE=S3
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
